# Copie para .env e preencha. Nunca commitar o .env de verdade.

# Banco (Supabase Postgres) — string de conexão direta (Session/Transaction
# pooler ou conexão direta, ver Project Settings > Database no Supabase).
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres

# Supabase (opcional; usado se precisarmos do client REST/Storage além do
# Postgres direto via asyncpg).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=

# LLM e embeddings (M3/M4) via OpenRouter — proxy compatível com a API da
# OpenAI, usado tanto pro chat (anthropic/claude-sonnet-4.5) quanto pros
# embeddings (openai/text-embedding-3-large, dim 3072). Ver CLAUDE.md
# (decisões do M3/M4) pra entender por que não é a Anthropic/OpenAI direto.
# Pegue uma chave em https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Não usadas no momento (o LLM e os embeddings passam pela OpenRouter
# acima) — ficam aqui só como ponto de extensão caso o projeto troque pra
# usar a Anthropic/OpenAI direto no futuro.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# INLABS (Imprensa Nacional / DOU) — conta pessoal gratuita.
# Ver research/FONTES.md, seção 3, para o fluxo de login/download validado.
INLABS_EMAIL=
INLABS_PASSWORD=

# Alertas (M7) — canal "webhook" (POST de um JSON pra uma URL sua) não
# precisa de nenhuma das duas chaves abaixo, só de uma regra com
# destino.url. RESEND_API_KEY habilita o canal "email" (chave em
# https://resend.com/api-keys); TELEGRAM_BOT_TOKEN habilita "telegram"
# (fale com @BotFather no Telegram pra criar um bot e pegar o token). Sem
# a chave do canal, o alerta ainda é criado mas esse canal específico
# falha ao disparar (fica registrado com erro em `alerta_disparo`, não
# derruba os outros canais da mesma regra nem o job do dia).
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Aplicação
ENVIRONMENT=development
