# Copie para .env.local e ajuste se o backend não estiver em localhost:8000.
# Nunca use NEXT_PUBLIC_ aqui — a URL do backend só é lida no servidor do
# Next.js (Server Components + Route Handlers), nunca no browser. Ver
# src/lib/api.ts.
API_BASE_URL=http://localhost:8000

# Login único do site inteiro (não é multiusuário) — ver src/lib/auth.ts e
# src/proxy.ts. Sem essas três, o proxy (antigo "middleware" — ver
# src/proxy.ts) nega todo acesso (falha fechada), inclusive em produção.
AUTH_USERNAME=troque-este-usuario
AUTH_PASSWORD=troque-esta-senha
# String aleatória longa que assina o cookie de sessão (não é a senha de
# login) — gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
