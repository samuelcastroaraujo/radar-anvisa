		pObj.style.backgroundPosition = "0px -9px";
		l_div_aps.innerHTML = "<div style='font-size: 8pt; margin-left: 21px;'>Carregando...</div>";
		setarPropriedadeDisplay(l_div_aps, "block");
		
		var link = "/action/ActionDatalegis.php?acao=recuperarGruposFilhosTipoAto&id="+pObj.parentNode.getAttribute("codigo");

		processarAjax(link, 'POST', "", montarTiposAssociados);		
