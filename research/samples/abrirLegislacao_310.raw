function apresentarOcultarDivsPesquisaAvancada(pDisplay) {
}

function retira_acentos(palavra) {
	var com_acento = 'áàãâäéèêëíìîïóòõôöúùûüçÁÀÃÂÄÉÈÊËÍÌÎÏÓÒÕÖÔÚÙÛÜÇ';
	var sem_acento = 'aaaaaeeeeiiiiooooouuuucAAAAAEEEEIIIIOOOOOUUUUC';
	var nova='';

	for(var i = 0; i < palavra.length; i++) {
		var p = com_acento.indexOf(palavra.substr(i,1));
		
		if (p > -1) {
			nova += sem_acento.substr(p,1);
		}else {
			nova += palavra.substr(i,1);
		}
	}
	return nova;
}

function abrirFrame(id, obj) {
	fAscendentes = "";//fAscendentes.toString().substring(0, fAscendentes.toString().length-1);

	var l_div = obj;
	if (l_div.getElementsByTagName('div')[0].style.display == "none" || l_div.getElementsByTagName('div')[0].style.display == ""){
		var l_frame = l_div.getElementsByTagName("iframe")[0];//recuperarObjetoPai(obj, 4).getElementsByTagName("iframe")[0];
		var link = "/action/TematicaAction.php?acao=visualizarTextoAtosVinculados&codigo=" + id + "&word="+fAscendentes;

		l_div.getElementsByTagName("span")[0].style.backgroundPosition = "0px -9px";
		l_div.getElementsByTagName('div')[0].style.display = "block";
		l_frame.src = link;
	}else {
		l_div.getElementsByTagName("span")[0].style.backgroundPosition = "0px 3px";
		l_div.getElementsByTagName('div')[0].style.display = "none";
	}
}

function mostrarTreeview() {
	document.getElementById("frameConteudo").style.display = "none";
	document.getElementById("treeview").style.display = "block";
}

function recuperarObjetoPai(obj, nuascendentes) {
	var objPai = obj;

	for ( var i = 0; i < nuascendentes; i++) {
		objPai = objPai.parentNode;
	}

	return objPai;
}

function setarPropriedadeDisplay(pObj, pDisplay){
	pObj.style.display = pDisplay;
}

function expandir(pObj, dshierarquia, nuAscendentes, nivel) {
	fDivPrincipal = recuperarObjetoPai(pObj, nuAscendentes);
	fDivLabel = pObj;
	fDivApresentacao = fDivPrincipal.getElementsByTagName('div')[4];
	fLevel = nivel;

	if (fDivApresentacao.style.display == "" || fDivApresentacao.style.display == "block") {
		fDivApresentacao.style.display = "none";
		setarClassColapse();
	} else {
		fDivApresentacao.innerHTML = "<div style='font-size: 8pt; margin-left: 21px;'>Carregando...</div>";
		fDivApresentacao.style.display = "block";

		buscarFilhos(retira_acentos(document.getElementsByName('filtroArvore')[0].value), dshierarquia);
	}
}

function buscarFilhos(filtro, dshierarquia) {
	var params = '/action/TematicaAction.php?acao=montarNovaTematica&cotematica=' + fDivPrincipal.getAttribute("codigo")+
				  "&notematica="+filtro+"&nivel="+fLevel+"&infiltro="+fDivPrincipal.getAttribute("infiltro")+
				  "&numero="+document.getElementsByName("numero")[0].value;

	processarAjax(params, 'POST', null, mostrarFilhos);
}

function mostrarFilhos(pRetorno) {
	fDivApresentacao.innerHTML = pRetorno;
	fDivApresentacao.style.display = "block";
	setarClassExpand();

	fDivPrincipal = null;
	fDivApresentacao = null;
	fDivLabel = null;
}

function abrirFrame(id, obj) {
	fAscendentes = obj.getElementsByTagName("a")[0].innerHTML + "|";

	recuperarTemasAcima(recuperarObjetoPai(obj, 6));
	fAscendentes = fAscendentes.toString().substring(0, fAscendentes.toString().length-1);

	var l_div = recuperarObjetoPai(obj, 4).getElementsByTagName("div")[4];
	if (l_div .style.display == "none" || l_div .style.display == ""){
		var l_frame = recuperarObjetoPai(obj, 4).getElementsByTagName("iframe")[0];
		var link = "/action/TematicaAction.php?acao=visualizarTextoAtosVinculados&codigo=" + id + "&word="+fAscendentes;
				
		l_div.style.display = "block";
		l_frame.src = link;
	}else {
		l_div.style.display = "none";
	}
}

function mostrarTipoAto(pObj) {
	l_div_grupo_tipo = pObj.parentNode.getElementsByTagName("div")[0];
	l_input_grupo = pObj.parentNode.parentNode.getElementsByTagName("input")[0];
	if (l_div_grupo_tipo.style.display == "block" ||
		l_div_grupo_tipo.style.display == ""){
		l_div_grupo_tipo.style.display = "none";
	}else {
		l_div_grupo_tipo.style.display = "block";
		if (l_div_grupo_tipo.innerHTML == ""){
			l_div_grupo_tipo.innerHTML = "Carregando...";
			
			var link = "/action/ActionDatalegis.php?acao=recuperarGruposFilhosTipoAto&id="+pObj.parentNode.parentNode.getAttribute("codigo");
			
			processarAjax(link, 'POST', "", apresentarGruposTipos);
		}
	}
}


function selecionarLegislacao() {	
	var oDivAvancado = document.getElementsByTagName("input");
	
	for (var i = 0; i < oDivAvancado.length; i++) {
		var oInput = oDivAvancado[i];

		if ((oInput.name == "ckGrupoTipoAto[]" && oInput.getAttribute("in_pr_mn") == "S") || oInput.name == "sgl_tipo[]" ) {
			oInput.checked = true;
		} else if (oInput.type == 'checkbox' && oInput.name != "tipoLegislacao[]") {
			oInput.checked = false;
		}
	}
}

function selecionarJurisprudencia() {	
	var oDivAvancado = document.getElementsByTagName("input");
	
	for (var i = 0; i < oDivAvancado.length; i++){
		var oInput = oDivAvancado[i];

		if ((oInput.name == "ckGrupoTipoAto[]" && oInput.getAttribute("in_pr_mn") == "N")){
			oInput.checked = true;
		}else if (oInput.type == 'checkbox' && oInput.name != "tipoLegislacao[]"){
			oInput.checked = false;
		}
	}
}

function selecionarLegisSuperior() {
	$('#Grupos_Tipos_Ato2 :checkbox').removeAttr('checked');
	apresentarOcultarDivsPesquisaAvancada('none');
	desmarcarTodosTipos();
	var l_linha = document.getElementById("Grupos_Tipos_Ato").rows[0];
	var l_coluna = l_linha.cells[0];
	var l_inputs = l_coluna.getElementsByTagName("input");
		
	for (var j = 0; j < l_inputs.length; j++){
		var l_input = l_inputs[j];
		
		if (!l_input.disabled){
			l_input.checked = true;
		}
	}
}

function totaisTipos() {
	var l_total_rapido = 0;
	var l_total_base = 0;
	var l_total_superior = 0;
	var l_total_complementar = 0;

	if (navigator.appName.toString().toLowerCase() != 'microsoft internet explorer'){
		document.getElementById("tipoRapido").innerHTML = document.getElementById("tipoRapido").innerHTML + ' ('+ l_total_rapido.format() +')'; 
		document.getElementById("tipoBase").innerHTML = document.getElementById("tipoBase").innerHTML + ' ('+ l_total_base.format() +')'; 
		document.getElementById("tipoSuperior").innerHTML = document.getElementById("tipoSuperior").innerHTML + ' ('+ l_total_superior.format() +')'; 
		document.getElementById("tipoComplementar").innerHTML = document.getElementById("tipoComplementar").innerHTML + ' ('+ l_total_complementar.format() +')'; 
	}else {
		document.getElementById("tipoRapido").innerHTML = document.getElementById("tipoRapido").innerHTML + ' ('+ l_total_rapido +')'; 
		document.getElementById("tipoBase").innerHTML = document.getElementById("tipoBase").innerHTML + ' ('+ l_total_base +')'; 
		document.getElementById("tipoSuperior").innerHTML = document.getElementById("tipoSuperior").innerHTML + ' ('+ l_total_superior +')'; 
		document.getElementById("tipoComplementar").innerHTML = document.getElementById("tipoComplementar").innerHTML + ' ('+ l_total_complementar +')';
	}
	
	selecionarBaseRapida();
}


function expandir(pObj, nuAscendentes) {
	l_div = recuperarObjetoPai(pObj, nuAscendentes);
	l_div_aps = l_div.getElementsByTagName('div')[0];

	if (l_div_aps.style.display == "" || l_div_aps.style.display == "block") {
		setarPropriedadeDisplay(l_div_aps, "none");
		pObj.style.backgroundPosition = "0px 3px";
