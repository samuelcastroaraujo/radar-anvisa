}

function montarTiposAssociados(pRetorno) {
	var indice = '';

	l_div_aps.innerHTML = pRetorno;
	setarPropriedadeDisplay(l_div_aps, "block");
}


function formatarNumero(p_valor) {
	var l_valor = "";
	var l_retorno = "";
	var l_count = 1;
	var l_ponto = "";
	
	for (var i = p_valor.toString().length-1; i >= 0; i--){
		if (l_count == 3 && i > 0) {
			l_ponto = ".";
			l_count = 0;
		}
		
		l_valor += p_valor[i].toString() + l_ponto;
		l_ponto = "";
		l_count++;
	}
	
	for (i = l_valor.toString().length-1; i >= 0; i--) {
		l_retorno += l_valor[i];
	}
	
	return l_retorno;
}

function trim(value) {
	return value.replace(/^\s+|\s+$/g, "");
}

function apresentarDivAutoComplete(p_obj) {
	var l_texto = trim(p_obj.value);
	
	if (l_texto != "") {
		recuperarSinonimosAutoComplete(l_texto);
	} else {
		document.getElementById("textoAutoComplete").style.display = "none";
	}
}

function recuperarSinonimosAutoComplete(p_texto) {
	var link = "/action/ActionDatalegis.php?acao=recuperarSinonimosAutoComplete&NO_SINONIMO="+p_texto;

	processarAjax(link, 'POST', "", apresentarSinonimosAutoComplete);	
}

function apresentarSinonimosAutoComplete(p_retorno) {
	if (trim(p_retorno) != "") {
		document.getElementById("textoAutoComplete").innerHTML = p_retorno;
		document.getElementById("textoAutoComplete").style.display = "block";
	}else {
		document.getElementById("textoAutoComplete").innerHTML = p_retorno;
		document.getElementById("textoAutoComplete").style.display = "none";
	}
}

function preencherCampo(p_obj) {
	document.getElementsByName("texto")[0].value = p_obj.childNodes[0].innerHTML;
	document.getElementById("textoAutoComplete").style.display = "none";
}

