String.prototype.trim = function () {
	return this.replace(/^\s+|\s+$/g,"");
}

function ValidaForm() {
   if(document.frmAssunto.titulo.value == ''){
      window.alert("Digite o texto a ser pesquisado");   	
      return false;	
   } else {
      return true;
   }		
